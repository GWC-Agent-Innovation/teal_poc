# Copy to .env and fill in. Never commit .env.
VLM_API_KEY=
VLM_MODEL=gpt-4o
# Any OpenAI-compatible endpoint (leave empty for OpenAI itself)
VLM_BASE_URL=
VLM_TIMEOUT_SECONDS=180
VLM_MAX_TOKENS=16000
# Set to true if your provider supports response_format=json_object
VLM_JSON_MODE=false

# --- Domo AI Service Layer (alternative provider; auto-selected when DOMO_API_KEY is set and VLM_API_KEY is empty) ---
# VLM_PROVIDER=domo
DOMO_API_KEY=
DOMO_BASE_URL=https://<instance>.domo.com/api
DOMO_MODEL=domo.google.gemini-2.5-pro

# --- Tellis (tellis/): 2D image -> TRELLIS.2 -> 3D model -> SolidWorks ---
# huggingface = official microsoft/TRELLIS.2 Space (no GPU needed; images are uploaded to Hugging Face)
# remote = tellis/trellis_server.py on a GPU machine; local = TRELLIS.2 installed here; none = uploaded meshes only
# (unset: remote if TRELLIS_URL is set, else local if trellis2 is importable, else huggingface)
TRELLIS_PROVIDER=
TRELLIS_HF_SPACE=microsoft/TRELLIS.2
# free token from https://huggingface.co/settings/tokens (read access); without it the GPU quota is tiny
HF_TOKEN=
TRELLIS_URL=
TRELLIS_MODEL=microsoft/TRELLIS.2-4B
TRELLIS_TIMEOUT_SECONDS=900
# longest side used when the job gives no size
TELLIS_DEFAULT_SIZE_MM=100
# triangle budget for the SolidWorks import (5000 ~ 10 s, 20000 ~ 100 s)
TELLIS_MAX_FACES=20000
SW_VISIBLE=true
